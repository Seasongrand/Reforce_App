# Copie para .env e ajuste. Segredos só aqui, nunca no código.

# --- Banco ---------------------------------------------------------------
DATABASE_URL=postgres://aulas:aulas@localhost:5433/aulas
# Banco usado pelos testes (é apagado e recriado a cada execução)
TEST_DATABASE_URL=postgres://aulas:aulas@localhost:5433/aulas_test

# --- Aplicação -------------------------------------------------------------
APP_BASE_URL=http://localhost:3000
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-um-segredo-de-pelo-menos-32-caracteres
# Ferramentas de desenvolvimento em /dev (relógio, caixa de saída, simuladores). Nunca 1 em produção.
DEV_TOOLS=1

# --- Regras de negócio (valores sugeridos pela especificação; veja docs/pendencias.md) ---
HOLD_MINUTES=10
PIX_EXPIRY_LEAD_MINUTES=1
COMMISSION_MARKETPLACE_BPS=1500
COMMISSION_TEACHER_LINK_BPS=500
DISPUTE_WINDOW_HOURS=24
TEACHER_NO_SHOW_MINUTES=15
CRIMINAL_RECORD_VALIDITY_MONTHS=6
CALENDAR_FREEBUSY_TIMEOUT_MS=2000
STUDENT_NO_SHOW_TEACHER_PCT=100
PRICE_FLOOR_CENTS=0
